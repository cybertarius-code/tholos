<% days = transactions.group_by(&:date) %>
<div class="mt-6 flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-3">
  <p class="text-sm text-slate-600 dark:text-slate-400">
    <%= l(search.month_start, format: "%B %Y").capitalize %> · <%= t("transactions.index.count", count: pagy.count) %>
  </p>
  <% if search.running_balance? %>
    <p class="text-sm text-slate-600 dark:text-slate-400">
      <%= t("transactions.index.current_balance", account: search.account.name) %>
      <%= render MoneyComponent.new(cents: search.account.balance_cents, currency: search.account.currency) %>
    </p>
  <% end %>
</div>

<% if transactions.empty? %>
  <%= render EmptyStateComponent.new(
        icon: "🔍",
        title: search.filtered? ? t("transactions.index.empty_filtered_title") : t("transactions.index.empty_title"),
        text: search.filtered? ? t("transactions.index.empty_filtered_text") : t("transactions.index.empty_text")
      ) %>
<% else %>
  <%# Escritorio: tabla densa %>
  <table class="mt-2 hidden w-full text-sm md:table">
    <caption class="sr-only"><%= t("transactions.index.title") %></caption>
    <thead>
      <tr class="text-left text-xs uppercase tracking-wide text-slate-600 dark:text-slate-400">
        <th scope="col" class="py-2 pr-3 font-medium"><%= t("transactions.index.columns.description") %></th>
        <th scope="col" class="py-2 pr-3 font-medium"><%= t("transactions.index.columns.category") %></th>
        <th scope="col" class="py-2 pr-3 font-medium"><%= t("transactions.index.columns.account") %></th>
        <th scope="col" class="py-2 pr-3 text-right font-medium"><%= t("transactions.index.columns.amount") %></th>
        <% if search.running_balance? %>
          <th scope="col" class="py-2 text-right font-medium"><%= t("transactions.index.columns.balance") %></th>
        <% end %>
      </tr>
    </thead>
    <% days.each do |date, day_transactions| %>
      <tbody>
        <tr>
          <th scope="rowgroup" colspan="<%= search.running_balance? ? 5 : 4 %>"
              class="border-t border-line pt-4 pb-1 text-left text-xs font-semibold text-ink dark:text-slate-100">
            <%= l(date, format: :day).capitalize %>
          </th>
        </tr>
        <% day_transactions.each do |transaction| %>
          <tr id="<%= dom_id(transaction) %>" class="align-top hover:bg-stone-50 dark:hover:bg-slate-800">
            <td class="py-2 pr-3">
              <%= link_to movement_title(transaction, search), edit_movement_path(transaction), class: "font-medium text-ink underline-offset-2 hover:underline" %>
              <% if (other = transfer_counterpart_account(transaction, search)) %>
                <%= link_to other.name, transactions_path(account_id: other.id, month: search.month), class: "text-accent underline hover:no-underline" %>
              <% end %>
              <% if transaction.receipt.attached? %>
                <%= link_to "📎", transaction_receipt_path(transaction), target: "_blank", rel: "noopener",
                      aria: { label: t("transactions.receipt.view") }, title: t("transactions.receipt.view"), class: "ml-1 no-underline" %>
              <% end %>
              <%= duplicate_movement_link(transaction, search) %>
              <span class="ml-1"><%= movement_badges(transaction) %></span>
              <% if transaction.notes.present? %>
                <span class="block max-w-md truncate text-xs text-slate-600 dark:text-slate-400"><%= transaction.notes %></span>
              <% end %>
            </td>
            <td class="py-2 pr-3 text-slate-700 dark:text-slate-300">
              <% if (category = movement_category(transaction, search)) %>
                <span class="inline-flex items-center gap-2">
                  <%= render CategoryIconComponent.new(color: category.color, icon: category.icon, size: :small) %>
                  <%= category.name %>
                </span>
              <% end %>
            </td>
            <td class="py-2 pr-3 text-slate-700 dark:text-slate-300"><%= movement_account(transaction, search).name %></td>
            <td class="whitespace-nowrap py-2 pr-3 text-right"><%= render MoneyComponent.new(cents: transaction.amount_cents, currency: transaction.currency) %></td>
            <% if search.running_balance? %>
              <td class="whitespace-nowrap py-2 text-right text-slate-700 dark:text-slate-300" data-running-balance>
                <% if (balance = running_balance_for(transaction)) %>
                  <%= render MoneyComponent.new(cents: balance, currency: transaction.currency) %>
                <% else %>
                  <span aria-label="<%= t("transactions.index.no_running_balance") %>">—</span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    <% end %>
  </table>

  <%# Móvil: lista %>
  <div class="md:hidden">
    <% days.each do |date, day_transactions| %>
      <h2 class="mt-4 text-xs font-semibold text-ink dark:text-slate-100"><%= l(date, format: :day).capitalize %></h2>
      <ul class="mt-1 divide-y divide-line">
        <% day_transactions.each do |transaction| %>
          <li class="flex items-start justify-between gap-3 py-3">
            <div class="min-w-0">
              <p class="break-words text-sm font-medium text-ink">
                <%= link_to movement_title(transaction, search), edit_movement_path(transaction), class: "underline-offset-2 hover:underline" %>
                <% if (other = transfer_counterpart_account(transaction, search)) %>
                  <%= link_to other.name, transactions_path(account_id: other.id, month: search.month), class: "text-accent underline hover:no-underline" %>
                <% end %>
                <% if transaction.receipt.attached? %>
                  <%= link_to "📎", transaction_receipt_path(transaction), target: "_blank", rel: "noopener",
                        aria: { label: t("transactions.receipt.view") }, title: t("transactions.receipt.view"), class: "ml-1 no-underline" %>
                <% end %>
                <%= duplicate_movement_link(transaction, search) %>
              </p>
              <p class="mt-0.5 break-words text-xs text-slate-600 dark:text-slate-400">
                <%= [ movement_category(transaction, search)&.name, movement_account(transaction, search).name ].compact.join(" · ") %>
              </p>
              <% if (badges = movement_badges(transaction)).present? %>
                <p class="mt-1 flex flex-wrap gap-1"><%= badges %></p>
              <% end %>
            </div>
            <div class="shrink-0 text-right text-sm">
              <%= render MoneyComponent.new(cents: transaction.amount_cents, currency: transaction.currency) %>
              <% if (balance = running_balance_for(transaction)) %>
                <p class="mt-0.5 text-xs text-slate-600 dark:text-slate-400">
                  <%= t("transactions.index.balance_after") %>
                  <%= render MoneyComponent.new(cents: balance, currency: transaction.currency) %>
                </p>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <% if pagy.last > 1 %>
    <nav class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4 text-sm" aria-label="<%= t("transactions.index.pagination") %>">
      <% if pagy.previous %>
        <%= link_to t("transactions.index.previous"), pagy.page_url(:previous), rel: "prev", data: { turbo_frame: "transactions_list" }, class: "text-accent underline hover:no-underline" %>
      <% else %>
        <span></span>
      <% end %>
      <span class="text-slate-600 dark:text-slate-400"><%= t("transactions.index.page", page: pagy.page, last: pagy.last) %></span>
      <% if pagy.next %>
        <%= link_to t("transactions.index.next"), pagy.page_url(:next), rel: "next", data: { turbo_frame: "transactions_list" }, class: "text-accent underline hover:no-underline" %>
      <% else %>
        <span></span>
      <% end %>
    </nav>
  <% end %>
<% end %>
