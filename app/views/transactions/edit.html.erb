<section class="rounded-xl border border-line bg-surface p-6 dark:bg-slate-900">
  <h1 class="text-2xl font-semibold text-ink dark:text-slate-100"><%= t(".title") %></h1>
  <%= render "form", transaction: @transaction %>

  <div class="mt-8 flex flex-wrap gap-3 border-t border-line pt-6">
    <% if transaction_receipt_saved?(@transaction) %>
      <%= form_with url: transaction_receipt_path(@transaction), method: :delete, data: { turbo_confirm: t(".remove_receipt_confirm") } do %>
        <%= render ButtonComponent.new(variant: :secondary, type: "submit") do %><%= t(".remove_receipt") %><% end %>
      <% end %>
    <% end %>
    <%= form_with url: transaction_path(@transaction), method: :delete, data: { turbo_confirm: t(".destroy_confirm") } do %>
      <%= render ButtonComponent.new(variant: :danger, type: "submit") do %><%= t(".destroy") %><% end %>
    <% end %>
  </div>
</section>
