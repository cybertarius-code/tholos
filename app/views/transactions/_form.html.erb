<%= form_with model: transaction, class: "max-w-xl", data: { controller: "transaction-form" } do |form| %>
  <% if transaction.errors[:base].any? %>
    <p class="mb-4 text-sm text-error" role="alert"><%= transaction.errors[:base].to_sentence %></p>
  <% end %>

  <fieldset class="my-5">
    <legend class="sr-only"><%= t("transactions.form.direction") %></legend>
    <div class="grid grid-cols-2 gap-1 rounded-lg border border-line p-1">
      <% Transaction::DIRECTIONS.each do |direction| %>
        <label class="flex min-h-11 cursor-pointer items-center justify-center rounded-md text-sm font-medium text-ink has-[:checked]:bg-ink has-[:checked]:text-white has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-accent dark:has-[:checked]:bg-slate-100 dark:has-[:checked]:text-slate-900">
          <%= form.radio_button :direction, direction, class: "sr-only",
                checked: transaction.direction == direction,
                data: { transaction_form_target: "direction", action: "transaction-form#filter" } %>
          <%= t("transactions.directions.#{direction}") %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="grid gap-x-4 sm:grid-cols-2">
    <%= render FormFieldComponent.new(
      form: form, attribute: :amount_input, label: t("activerecord.attributes.transaction.amount"),
      help_text: t("transactions.form.amount_help"),
      error: transaction.errors[:amount].first || transaction.errors[:currency].first,
      input_options: { required: true, inputmode: "decimal", autocomplete: "off", placeholder: "0,00",
                       autofocus: transaction.new_record? }
    ) %>

    <%= render FormFieldComponent.new(
      form: form, attribute: :date, label: t("activerecord.attributes.transaction.date"),
      input_type: :date, error: transaction.errors[:date].first,
      input_options: { required: true }
    ) %>
  </div>

  <%= render FormFieldComponent.new(
    form: form, attribute: :account_id, label: t("activerecord.attributes.transaction.account_id"),
    input_type: :select, choices: [ [ t("transactions.form.choose_account"), "" ] ] + transaction_account_options(transaction),
    error: transaction.errors[:account_id].first,
    input_options: { required: true }
  ) %>

  <%= render FormFieldComponent.new(
    form: form, attribute: :category_id, label: t("activerecord.attributes.transaction.category_id"),
    input_type: :select, choices: transaction_category_options(transaction),
    error: transaction.errors[:category_id].first,
    input_options: { data: { transaction_form_target: "category" } }
  ) %>

  <%= render FormFieldComponent.new(
    form: form, attribute: :payee, label: t("activerecord.attributes.transaction.payee"),
    error: transaction.errors[:payee].first,
    input_options: { maxlength: 120 }
  ) %>

  <%= render FormFieldComponent.new(
    form: form, attribute: :status, label: t("activerecord.attributes.transaction.status"),
    input_type: :select, choices: transaction_status_options,
    help_text: t("transactions.form.status_help"),
    error: transaction.errors[:status].first
  ) %>

  <%= render FormFieldComponent.new(
    form: form, attribute: :notes, label: t("activerecord.attributes.transaction.notes"),
    input_type: :text_area, input_options: { rows: 3 }
  ) %>

  <div class="flex flex-wrap gap-3">
    <%= render ButtonComponent.new(type: "submit") do %><%= t("transactions.form.submit") %><% end %>
    <%= render ButtonComponent.new(variant: :secondary,
          href: transaction.account_id? ? account_path(transaction.account_id) : accounts_path) do %>
      <%= t("transactions.form.cancel") %>
    <% end %>
  </div>
<% end %>
