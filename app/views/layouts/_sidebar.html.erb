<aside class="hidden min-h-dvh w-64 shrink-0 flex-col border-r border-line bg-surface px-4 py-6 dark:bg-slate-900 lg:flex">
  <%= link_to "Tholos", dashboard_path, class: "mb-8 rounded px-3 text-xl font-bold text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink dark:text-slate-100" %>

  <nav aria-label="<%= t("navigation.primary") %>" class="flex-1 space-y-1">
    <%= nav_link_to(t("navigation.dashboard"), dashboard_path) %>
    <%= nav_link_to(t("navigation.movements"), movements_path) %>
    <%= nav_link_to(t("navigation.accounts"), accounts_path) %>
    <%= nav_link_to(t("navigation.budget"), budget_path) %>
    <%= nav_link_to(t("navigation.goals"), goals_path) %>
    <%= nav_link_to(t("navigation.net_worth"), net_worth_path) %>
    <%= nav_link_to(t("navigation.settings"), settings_path) %>
  </nav>

  <%= button_to t("shared.sign_out"), session_path, method: :delete, class: "mt-6 w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-slate-700 hover:bg-stone-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink dark:text-slate-200 dark:hover:bg-slate-800" %>
</aside>
