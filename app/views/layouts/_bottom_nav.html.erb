<nav aria-label="<%= t("navigation.primary") %>" class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur dark:border-slate-800 dark:bg-slate-900/95 lg:hidden">
  <div class="mx-auto grid max-w-lg grid-cols-4 items-center gap-1 px-2 py-2">
    <%= nav_link_to(t("navigation.dashboard"), dashboard_path) %>
    <%= nav_link_to(t("navigation.movements"), movements_path) %>
    <%= nav_link_to(t("navigation.accounts"), accounts_path) %>
    <details class="relative">
      <summary class="cursor-pointer list-none rounded-lg px-3 py-2 text-center text-sm font-medium text-slate-700 hover:bg-stone-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink dark:text-slate-200 dark:hover:bg-slate-800">
        <%= t("navigation.more") %>
      </summary>
      <div class="absolute bottom-full right-0 mb-2 w-52 rounded-lg border border-line bg-surface p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900">
        <%= nav_link_to(t("navigation.budget"), budget_path) %>
        <%= nav_link_to(t("navigation.goals"), goals_path) %>
        <%= nav_link_to(t("navigation.net_worth"), net_worth_path) %>
        <%= nav_link_to(t("navigation.settings"), settings_path) %>
        <%= button_to t("shared.sign_out"), session_path, method: :delete, class: "mt-1 w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-slate-700 hover:bg-stone-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink dark:text-slate-200 dark:hover:bg-slate-800" %>
      </div>
    </details>
  </div>
</nav>
