<section class="rounded-xl border border-line bg-surface p-6 dark:bg-slate-900">
  <h1 class="text-2xl font-semibold text-ink dark:text-slate-100"><%= t("navigation.#{@section}") %></h1>
  <% if @section == "settings" %>
    <div class="mt-6 max-w-sm">
      <label for="theme-preference" class="block text-sm font-medium text-ink"><%= t("settings.theme.label") %></label>
      <select id="theme-preference"
              data-controller="theme"
              data-action="change->theme#change"
              class="mt-2 block w-full rounded-md border border-line bg-surface px-3 py-2 text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
        <% ApplicationHelper::THEMES.each do |theme| %>
          <option value="<%= theme %>" <%= "selected" if theme_preference == theme %>><%= t("settings.theme.#{theme}") %></option>
        <% end %>
      </select>
    </div>
  <% end %>
  <%= render EmptyStateComponent.new(
    icon: "…",
    title: t("coming_soon.title"),
    text: t("coming_soon.message")
  ) %>
</section>
