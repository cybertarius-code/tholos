<%# Una fila del extracto en su Turbo Frame: se corrige y se decide sin recargar la página %>
<%= turbo_frame_tag row do %>
  <div class="py-3 <%= "rounded-md bg-red-50 px-2 dark:bg-slate-800" if row.commit_error %>">
    <div class="flex flex-wrap items-center gap-2 text-xs text-slate-600 dark:text-slate-400">
      <span><%= t("imports.row.line", line: row.line) %></span>
      <% if row.proposal_duplicate? %>
        <%= render BadgeComponent.new do %><%= t("imports.row.duplicate") %><% end %>
      <% elsif row.proposal_before_cutoff? %>
        <%= render BadgeComponent.new do %><%= t("imports.row.before_cutoff") %><% end %>
      <% elsif row.undecided? %>
        <%= render BadgeComponent.new(variant: :warning) do %><%= t("imports.row.undecided") %><% end %>
      <% end %>
      <span class="ml-auto"><%= t("imports.row.balance") %> <%= render MoneyComponent.new(cents: row.balance_cents) %></span>
    </div>

    <% if row.commit_error %>
      <p class="mt-1 text-sm text-error" role="alert"><%= row.commit_error %></p>
    <% end %>

    <% if row.locked? %>
      <div class="mt-1 flex items-start justify-between gap-4 text-sm">
        <span class="min-w-0">
          <span class="block break-words font-medium text-ink"><%= row.concept %></span>
          <span class="block text-xs text-slate-600 dark:text-slate-400">
            <%= l(row.date, format: :short) %> ·
            <%= row.skipped? ? t("imports.row.skip") : row.category&.name %>
          </span>
        </span>
        <span class="shrink-0 whitespace-nowrap"><%= render MoneyComponent.new(cents: row.amount_cents) %></span>
      </div>
    <% else %>
      <% if row.errors.any? %>
        <p class="mt-1 text-sm text-error" role="alert"><%= row.errors.full_messages.to_sentence %></p>
      <% end %>
      <%= form_with model: row, url: import_row_path(row), method: :patch, namespace: dom_id(row),
            class: "mt-2 grid grid-cols-2 items-end gap-2 md:grid-cols-[9rem_minmax(0,1fr)_7rem_minmax(0,14rem)_auto]" do |form| %>
        <div>
          <%= form.label :date, t("imports.row.date"), class: "block text-xs text-slate-600 dark:text-slate-400" %>
          <%= form.date_field :date, required: true, class: "mt-1 block w-full rounded-md border border-line bg-surface px-2 py-1.5 text-sm text-ink" %>
        </div>
        <div class="col-span-2 row-start-1 md:col-span-1 md:row-start-auto">
          <%= form.label :concept, t("imports.row.concept"), class: "block text-xs text-slate-600 dark:text-slate-400" %>
          <%= form.text_field :concept, required: true, autocomplete: "off", class: "mt-1 block w-full rounded-md border border-line bg-surface px-2 py-1.5 text-sm text-ink" %>
        </div>
        <div>
          <%= form.label :amount_input, t("imports.row.amount"), class: "block text-xs text-slate-600 dark:text-slate-400" %>
          <%= form.text_field :amount_input, required: true, autocomplete: "off", class: "mt-1 block w-full rounded-md border border-line bg-surface px-2 py-1.5 text-right text-sm text-ink" %>
        </div>
        <div class="col-span-2 md:col-span-1">
          <%= form.label :decision, t("imports.row.decision"), class: "block text-xs text-slate-600 dark:text-slate-400" %>
          <%= form.select :decision, import_decision_options(row), {}, class: "mt-1 block w-full rounded-md border border-line bg-surface px-2 py-1.5 text-sm text-ink" %>
        </div>
        <%= render ButtonComponent.new(type: "submit", size: :small, variant: :secondary, class: "col-span-2 md:col-span-1") do %><%= t("imports.row.save") %><% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
