<div class="mx-auto md:w-2/3 w-full">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-error font-medium rounded-lg inline-block dark:bg-slate-800" id="alert"><%= alert %></p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-success font-medium rounded-lg inline-block dark:bg-slate-800" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl"><%= t("sessions.new.title") %></h1>

  <%= form_with url: session_url, class: "contents" do |form| %>
    <%= render FormFieldComponent.new(
      form: form,
      attribute: :email_address,
      label: t("sessions.new.email_label"),
      input_type: :email,
      input_options: {
        required: true,
        autofocus: true,
        autocomplete: "username",
        inputmode: "email",
        placeholder: t("sessions.new.email_placeholder"),
        value: params[:email_address]
      }
    ) %>

    <%= render FormFieldComponent.new(
      form: form,
      attribute: :password,
      label: t("sessions.new.password_label"),
      input_type: :password,
      input_options: {
        required: true,
        autocomplete: "current-password",
        placeholder: t("sessions.new.password_placeholder"),
        maxlength: 72
      }
    ) %>

    <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
      <div class="inline">
        <%= render ButtonComponent.new(type: "submit", size: :medium) do %>
          <%= t("sessions.new.submit") %>
        <% end %>
      </div>

      <div class="mt-4 text-sm text-gray-500 dark:text-slate-400 sm:mt-0">
        <%= link_to t("sessions.new.forgot_password"), new_password_path, class: "inline-flex min-h-11 items-center text-gray-700 underline hover:no-underline dark:text-slate-200" %>
      </div>
    </div>
  <% end %>
</div>
