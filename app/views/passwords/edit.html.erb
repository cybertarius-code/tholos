<div class="mx-auto md:w-2/3 w-full">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-error font-medium rounded-lg inline-block dark:bg-slate-800" id="alert"><%= alert %></p>
  <% end %>

  <h1 class="font-bold text-4xl"><%= t("passwords.edit.title") %></h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.password_field :password, required: true, autocomplete: t("passwords.edit.autocomplete"), placeholder: t("passwords.edit.placeholder"), maxlength: 72, class: "block shadow-sm rounded-md border border-line bg-surface text-ink focus:outline-solid focus:outline-accent px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.password_field :password_confirmation, required: true, autocomplete: t("passwords.edit.autocomplete"), placeholder: t("passwords.edit.confirmation_placeholder"), maxlength: 72, class: "block shadow-sm rounded-md border border-line bg-surface text-ink focus:outline-solid focus:outline-accent px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="inline">
      <%= form.submit t("passwords.edit.submit"), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white inline-block font-medium cursor-pointer dark:bg-slate-700 dark:hover:bg-slate-600" %>
    </div>
  <% end %>
</div>
