<div class="mx-auto md:w-2/3 w-full">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-error font-medium rounded-lg inline-block dark:bg-slate-800" id="alert"><%= alert %></p>
  <% end %>

  <h1 class="font-bold text-4xl"><%= t("passwords.edit.title") %></h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.password_field :password, required: true, autocomplete: t("passwords.edit.autocomplete"), placeholder: t("passwords.edit.placeholder"), maxlength: 72, class: "mt-2 block w-full rounded-md border border-line bg-surface px-3 py-2 text-base text-ink shadow-sm focus:outline-solid focus:outline-accent" %>
    </div>

    <div class="my-5">
      <%= form.password_field :password_confirmation, required: true, autocomplete: t("passwords.edit.autocomplete"), placeholder: t("passwords.edit.confirmation_placeholder"), maxlength: 72, class: "mt-2 block w-full rounded-md border border-line bg-surface px-3 py-2 text-base text-ink shadow-sm focus:outline-solid focus:outline-accent" %>
    </div>

    <div class="inline">
      <%= form.submit t("passwords.edit.submit"), class: "inline-flex min-h-11 w-full items-center justify-center rounded-md px-3.5 py-2.5 text-center bg-blue-600 hover:bg-blue-700 text-white font-medium cursor-pointer sm:w-auto dark:bg-slate-700 dark:hover:bg-slate-600" %>
    </div>
  <% end %>
</div>
