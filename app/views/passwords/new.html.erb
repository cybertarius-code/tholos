<div class="mx-auto md:w-2/3 w-full">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-error font-medium rounded-lg inline-block dark:bg-slate-800" id="alert"><%= alert %></p>
  <% end %>

  <h1 class="font-bold text-4xl"><%= t("passwords.new.title") %></h1>

  <%= form_with url: passwords_path, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", inputmode: "email", placeholder: t("passwords.new.placeholder"), value: params[:email_address], class: "mt-2 block w-full rounded-md border border-line bg-surface px-3 py-2 text-base text-ink shadow-sm focus:outline-solid focus:outline-accent" %>
    </div>

    <div class="inline">
      <%= form.submit t("passwords.new.submit"), class: "inline-flex min-h-11 w-full items-center justify-center rounded-lg px-3.5 py-2.5 text-center bg-blue-600 hover:bg-blue-700 text-white font-medium cursor-pointer sm:w-auto dark:bg-slate-700 dark:hover:bg-slate-600" %>
    </div>
  <% end %>
</div>
