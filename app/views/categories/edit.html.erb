<section class="rounded-xl border border-line bg-surface p-6 dark:bg-slate-900">
  <h1 class="text-2xl font-semibold text-ink dark:text-slate-100"><%= t(".title", name: @category.name) %></h1>
  <%= render "form", category: @category %>

  <div class="mt-8 border-t border-line pt-6">
    <h2 class="text-lg font-medium text-ink dark:text-slate-100"><%= t(".danger_zone") %></h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400"><%= t(".danger_help") %></p>
    <div class="mt-4 flex flex-wrap gap-3">
      <% if @category.archived? %>
        <%= form_with url: category_archive_path(@category), method: :delete do %>
          <%= render ButtonComponent.new(variant: :secondary, type: "submit") do %><%= t(".unarchive") %><% end %>
        <% end %>
      <% else %>
        <%= form_with url: category_archive_path(@category), method: :post,
              data: (@category.root? ? { turbo_confirm: t(".archive_confirm") } : {}) do %>
          <%= render ButtonComponent.new(variant: :secondary, type: "submit") do %><%= t(".archive") %><% end %>
        <% end %>
      <% end %>
      <%= form_with url: category_path(@category), method: :delete, data: { turbo_confirm: t(".destroy_confirm") } do %>
        <%= render ButtonComponent.new(variant: :danger, type: "submit") do %><%= t(".destroy") %><% end %>
      <% end %>
    </div>
  </div>
</section>
