<section class="rounded-xl border border-line bg-surface p-6 dark:bg-slate-900">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold text-ink dark:text-slate-100"><%= t("navigation.accounts") %></h1>
    <%= render ButtonComponent.new(href: new_account_path) do %><%= t(".new") %><% end %>
  </div>

  <% if @accounts.any? %>
    <ul class="mt-6 divide-y divide-line">
      <% @accounts.each do |account| %>
        <li id="<%= dom_id(account) %>">
          <%= link_to account_path(account), class: "flex items-center justify-between gap-4 rounded-md px-2 py-3 hover:bg-stone-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink dark:hover:bg-slate-800" do %>
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-ink dark:text-slate-100"><%= account.name %></p>
              <p class="flex flex-wrap items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
                <%= account_kind_label(account) %>
                <% if account.closed? %>
                  <%= render BadgeComponent.new do %><%= t("accounts.statuses.closed") %><% end %>
                <% end %>
              </p>
            </div>
            <%= render MoneyComponent.new(cents: account.balance_cents, currency: account.currency) %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render EmptyStateComponent.new(
      icon: "▤",
      title: t(".empty_title"),
      text: t(".empty_text"),
      action_label: t(".new"),
      action_href: new_account_path
    ) %>
  <% end %>
</section>
