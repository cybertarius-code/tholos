<section class="min-w-0 rounded-xl border border-line bg-surface p-4 sm:p-6 dark:bg-slate-900">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold text-ink dark:text-slate-100"><%= t("navigation.accounts") %></h1>
    <%= render ButtonComponent.new(href: new_account_path) do %><%= t(".new") %><% end %>
  </div>

  <% if @accounts.any? %>
    <% group_titles = { cash_and_banks: t(".groups.cash_and_banks"), cards_and_loans: t(".groups.cards_and_loans") } %>
    <% @groups.each do |group, accounts| %>
      <section class="mt-8" aria-labelledby="group-<%= group %>">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 id="group-<%= group %>" class="text-lg font-medium text-ink dark:text-slate-100"><%= group_titles.fetch(group) %></h2>
          <%= render "totals", accounts: accounts, balances: @balances %>
        </div>
        <ul class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <%= render partial: "card", collection: accounts, as: :account, locals: { balances: @balances } %>
        </ul>
      </section>
    <% end %>

    <% if @closed_accounts.any? %>
      <details class="mt-8" id="closed-accounts">
        <summary class="cursor-pointer text-lg font-medium text-ink dark:text-slate-100">
          <%= t(".closed", count: @closed_accounts.size) %>
        </summary>
        <ul class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <%= render partial: "card", collection: @closed_accounts, as: :account, locals: { balances: @balances } %>
        </ul>
      </details>
    <% end %>
  <% else %>
    <%= render EmptyStateComponent.new(
      icon: "▤",
      title: t(".empty_title"),
      text: t(".empty_text"),
      action_label: t(".new"),
      action_href: new_account_path
    ) %>
  <% end %>
</section>
