<section class="mx-auto flex max-w-lg flex-col items-center px-6 py-12 text-center">
  <span aria-hidden="true" class="mb-4 text-4xl text-ink dark:text-slate-100"><%= @icon %></span>
  <h2 class="text-xl font-semibold text-ink dark:text-slate-100"><%= @title %></h2>
  <p class="mt-2 text-sm text-slate-600 dark:text-slate-400"><%= @text %></p>
  <% if @action_label.present? %>
    <div class="mt-6">
      <%= render ButtonComponent.new(href: @action_href) do %><%= @action_label %><% end %>
    </div>
  <% end %>
</section>
